# Runtime
NODE_ENV=production
PORT=4000

# Public frontend origins, comma-separated and without trailing slash
FRONTEND_URL=https://www.example.com
CORS_ORIGINS=https://www.example.com

# PostgreSQL (use the private hostname supplied by Coolify)
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Authentication (generate a long random value; never commit it)
JWT_SECRET=

# File storage. Local storage requires a persistent mount at /app/uploads.
STORAGE_PROVIDER=local
UPLOADS_DIR=/app/uploads

# Optional: only required when STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
