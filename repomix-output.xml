}

.chroma-img-wrapper img,
.chroma-img-wrapper .chroma-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  border-radius: 0;
  display: block;
}

.chroma-info {
  position: relative;
  z-index: 1;
  padding: 1.25rem;
  background: white;
  font-family: var(--font-opensans), ui-sans-serif, system-ui, sans-serif;
  display: grid;
  grid-template-columns: 1fr auto;
  grid-template-rows: auto auto;
  row-gap: 0.5rem;
  column-gap: 0.75rem;
  border-top: 3px solid #CBA135;
  align-items: start;
}

.chroma-info .name {
  font-family: var(--font-montserrat), ui-sans-serif, system-ui, sans-serif;
  font-weight: 600;
  font-size: 1.125rem;
  line-height: 1.4;
  margin: 0;
  color: #1f2937;
  grid-column: 1;
  grid-row: 1;
  align-self: center;
}

.chroma-info .role {
  font-family: var(--font-opensans), ui-sans-serif, system-ui, sans-serif;
  font-weight: 400;
  font-size: 0.875rem;
  line-height: 1.5;
  color: #6b7280;
  margin: 0;
  grid-column: 1 / -1;
  grid-row: 2;
}

.chroma-info .handle {
  font-family: var(--font-opensans), ui-sans-serif, system-ui, sans-serif;
  font-weight: 600;
  font-size: 0.8rem;
  color: #CBA135;
  letter-spacing: 0.025em;
  background: rgba(203, 161, 53, 0.1);
  padding: 0.25rem 0.5rem;
  border-radius: 6px;
  grid-column: 2;
  grid-row: 1;
  align-self: center;
  justify-self: end;
}

.chroma-info .location {
  font-family: var(--font-opensans), ui-sans-serif, system-ui, sans-serif;
  font-weight: 400;
  font-size: 0.75rem;
  color: #9ca3af;
  font-style: italic;
}

.chroma-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 3;
  background: transparent;
  opacity: 0;
}

.chroma-fade {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 4;
  background: transparent;
  opacity: 0;
}
