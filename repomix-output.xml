        )}

        {/* Bottom CTA - Show only when there are publications */}
        {filteredPublicaciones.length > 0 && (
        <motion.div
          className="text-center mt-16"
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.8, delay: 0.4 }}
