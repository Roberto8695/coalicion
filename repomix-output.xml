    }

    // Obtener noticias por status
    async findByStatus(status, page = 1, limit = 10) {
        try {
            const offset = (page - 1) * limit;
            const query = `
                SELECT * FROM ${this.tableName}
                WHERE status = $1
                ORDER BY date DESC
                LIMIT $2 OFFSET $3
            `;
            const result = await pool.query(query, [status, limit, offset]);

