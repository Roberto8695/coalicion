        if (!/^\d+$/.test(req.params.id)) {
            return res.status(400).json({
                success: false,
                message: 'ID debe ser un número válido'
            });
        }
        controller.getById(req, res);
    });

    // GET /api/{resource}/slug/:slug - Obtener por slug (requiere autenticación)
