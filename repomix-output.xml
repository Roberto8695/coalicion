@import "tailwindcss";

/* Aplicar fuente sans globalmente */
* {
  font-family: var(--font-opensans), ui-sans-serif, system-ui, sans-serif;
}

:root {
  --background: #ffffff;
  --foreground: #171717;
}
html {
  scroll-behavior: smooth;
}
@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-opensans);
  --font-montserrat: var(--font-montserrat);
  --font-opensans: var(--font-opensans);
  --font-geist-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
  --animate-first: moveVertical 30s ease infinite;
  --animate-second: moveInCircle 20s reverse infinite;
  --animate-third: moveInCircle 40s linear infinite;
  --animate-fourth: moveHorizontal 40s ease infinite;
  --animate-fifth: moveInCircle 20s ease infinite;
  --animate-slideIn: slideIn 0.4s ease-out forwards;
}
 
  @keyframes moveHorizontal {
    0% {
      transform: translateX(-50%) translateY(-10%);
    }
    50% {
      transform: translateX(50%) translateY(10%);
    }
    100% {
      transform: translateX(-50%) translateY(-10%);
    }
  }
 
  @keyframes moveInCircle {
    0% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(180deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
 
  @keyframes moveVertical {
    0% {
      transform: translateY(-50%);
    }
    50% {
      transform: translateY(50%);
    }
    100% {
      transform: translateY(-50%);
    }
  }

/* Animaciones para el menú móvil */
@keyframes slideIn {
  0% {
    opacity: 0;
    transform: translateY(-10px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Clase de animación personalizada */
.animate-slideIn {
  animation: slideIn 0.4s ease-out forwards;
}

/* Animaciones para el ícono de scroll */
@keyframes scrollBounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-8px);
  }
  60% {
    transform: translateY(-4px);
  }
}

@keyframes scrollPulse {
  0%, 100% {
    opacity: 0.7;
  }
  50% {
    opacity: 1;
  }
}

.animate-scrollBounce {
  animation: scrollBounce 2s infinite;
}

.animate-scrollPulse {
  animation: scrollPulse 1.5s infinite;
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-opensans), var(--font-geist-sans), Arial, Helvetica, sans-serif;
}

/* Clases de fuentes para Tailwind */
.font-montserrat {
  font-family: var(--font-montserrat), ui-sans-serif, system-ui, sans-serif;
}

.font-opensans {
  font-family: var(--font-opensans), ui-sans-serif, system-ui, sans-serif;
}

/* Aplicar fuentes automáticamente a elementos */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-montserrat), ui-sans-serif, system-ui, sans-serif;
}

p, span, div:not(.font-montserrat), a, button:not(.font-montserrat) {
  font-family: var(--font-opensans), ui-sans-serif, system-ui, sans-serif;
}

/* Mejoras para móviles */
@media (max-width: 768px) {
  /* Eliminar líneas y bordes no deseados */
  nav, header {
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }
  
  /* Eliminar tap highlights */
  * {
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    -khtml-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
  }
  
  /* Mejores áreas de toque */
  button, a {
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: none;
    outline: none;
  }
  
  /* Prevenir zoom en inputs en iOS */
  input, select, textarea {
    font-size: 16px;
  }
  
  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }
  
  /* Mejor handling de touch */
  * {
    -webkit-tap-highlight-color: transparent;
  }
}




.hero-content-overlay {
  background: radial-gradient(
    circle at center,
    rgba(0, 0, 0, 0.2) 0%,
    rgba(0, 0, 0, 0.4) 100%
  );
}

/* Enhanced backdrop blur for hero content */


/* Ensure proper layering */
.hero-background-layer {
  z-index: 1;
}

.hero-mask-layer {
  z-index: 10;
}

.hero-overlay-layer {
  z-index: 20;
}

.hero-content-layer {
  z-index: 50;
}

/* Logos Slider Styles */
.logos-track {
  width: 100%;
  overflow: hidden;
  position: relative;
}

.logos-slider-infinite {
  display: flex;
  width: calc(300% + 60px); /* Ancho triplicado para seamless loop perfecto */
  transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.logo-item {
  flex: 0 0 auto;
  margin: 0 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 120px; /* Ancho mínimo para consistencia */
}

.logo-container {
  padding: 20px;
  border-radius: 16px;
  background: transparent;
  transition: all 0.5s ease;
  position: relative;
  border: 2px solid transparent;
}

.logo-container:hover {
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  transform: translateY(-8px);
  border-color: rgba(255, 196, 77, 0.3);
}

.logo-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.05) 100%);
  opacity: 0;
  transition: opacity 0.5s ease;
}

.logo-container:hover::before {
  opacity: 1;
}

/* Infinite sliding animation seamless */
@keyframes slide-infinite-seamless {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-33.333%); /* Mueve exactamente 1/3 para seamless loop */
  }
}

/* Responsive adjustments */
@media (max-width: 640px) {
  .logos-slider-infinite {
    animation-duration: 45s;
  }
  
  .logo-item {
    margin: 0 15px;
    min-width: 100px;
  }
  
  .logo-container {
    padding: 15px;
  }
}

@media (max-width: 480px) {
  .logos-slider-infinite {
    animation-duration: 35s;
  }
  
  .logo-item {
    margin: 0 10px;
    min-width: 80px;
  }
  
  .logo-container {
    padding: 12px;
  }
}

/* Fade effect for smooth edges */
.logos-track::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100px;
  height: 100%;
  background: linear-gradient(to right, rgba(249, 250, 251, 1), transparent);
  z-index: 10;
  pointer-events: none;
}

.logos-track::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 100px;
  height: 100%;
  background: linear-gradient(to left, rgba(249, 250, 251, 1), transparent);
  z-index: 10;
  pointer-events: none;
}

/* Estilos para FAQ Section */
.faq-accordion {
  scroll-behavior: smooth;
}

.faq-category-button {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.faq-category-button:hover {
  transform: translateY(-2px);
}

.faq-item {
  transition: all 0.3s ease;
}

.faq-item:hover {
  transform: translateY(-2px);
}

/* Animaciones suaves para el acordeón */
.faq-content {
  overflow: hidden;
}

/* Mejoras de accesibilidad para FAQ */
.faq-button:focus {
  outline: 2px solid #B91C1C;
  outline-offset: 2px;
}

@media (max-width: 640px) {
  .faq-categories {
    gap: 0.5rem;
  }
  
  .faq-category-button {
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
  }
}

/* Utilidades adicionales */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
