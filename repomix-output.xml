                : `No hay noticias con estado "${statusOptions.find(s => s.id === selectedStatus)?.label}".`
              }
            </p>
          </motion.div>
        )}

        {/* Bottom CTA - Show only when there are items */}
        {filteredNoticias.length > 0 && (
