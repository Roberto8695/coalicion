      thumbnail: item.thumbnail || '',
      downloadurl: item.downloadurl || '',
      previewurl: item.previewurl || '',
      duration: item.duration || '',
      format: item.format || '',
      size: item.size || '',
      tags: Array.isArray(item.tags) ? item.tags.join(', ') : (item.tags || ''),
      featured: item.featured || false,
      slug: item.slug || '',
