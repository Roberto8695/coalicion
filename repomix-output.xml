            <IconMicrophone className="h-5 w-5 text-green-600" />
            <span className="text-green-700 font-opensans font-medium">
              Suscríbete para recibir notificaciones de nuevas actividades
            </span>
          </div>
        </motion.div>
        )}
      </div>
    </motion.section>
  );
}
