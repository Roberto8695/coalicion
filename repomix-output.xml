        title={
          modalMode === 'create' ? 'Nuevo Evento' :
          modalMode === 'edit' ? 'Editar Evento' : 'Detalles del Evento'
        }
        size="large"
      >
        {modalMode === 'view' ? (
          /* Vista de solo lectura */
          <div className="space-y-4">
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
